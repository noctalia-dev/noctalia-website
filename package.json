{
	"name": "noctalia-site",
	"private": true,
	"version": "0.0.1",
	"packageManager": "npm@10.9.4",
	"type": "module",
	"scripts": {
		"og": "node scripts/build-og.mjs",
		"showcase": "node scripts/build-github-showcase.mjs",
		"plugin-wall": "node scripts/build-plugin-wall.mjs",
		"dev": "node scripts/build-og.mjs && vite dev",
		"start": "node scripts/build-og.mjs && vite dev",
		"prebuild": "node scripts/prebuild.mjs",
		"build": "vite build",
		"prepreview": "node scripts/build-og.mjs && node scripts/build-github-showcase.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@fontsource/inter": "^5.3.0",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"react": "^19.3.1",
		"satori": "^0.63.2",
		"sharp": "^0.35.5",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "6.0.3",
		"vite": "8.3.5"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"fuse.js": "^7.5.0",
		"marked": "^18.1.2",
		"smol-toml": "^1.9.1"
	},
	"overrides": {
		"@tailwindcss/typography": {
			"postcss-selector-parser": "^7.1.6"
		},
		"source-map-js": "^1.2.2",
		"vite": "8.3.5",
		"fflate": "0.8.3"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
